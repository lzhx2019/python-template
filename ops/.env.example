# ============================================================
# Docker Compose 环境变量配置模板
# 复制为 .env 并修改后使用：cp .env.example .env
# ============================================================

# ---------- 后端配置 ----------
DATABASE_URL=sqlite:///./app.db
SECRET_KEY=please-change-this-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost"]

# ---------- 端口映射 ----------
BACKEND_PORT=8000
FRONTEND_PORT=80
